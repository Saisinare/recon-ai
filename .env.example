# Copy to .env and fill in only the providers you use. .env is git-ignored.
# none | ollama | groq | gemini | openrouter
RECON_PROVIDER=none

# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional model overrides
# RECON_MODEL_GROQ=openai/gpt-oss-120b
# RECON_MODEL_GEMINI=gemini-2.5-flash
# RECON_MODEL_OPENROUTER=meta-llama/llama-3.3-70b-instruct:free
# RECON_MODEL_OLLAMA=qwen2.5:7b
